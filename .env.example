# Generate a strong value for real deployments: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
LOG_LEVEL=INFO

# Offline mode exercises MCP tools without an LLM or API credits.
AGENT_MODE=offline

# For OpenRouter, set AGENT_MODE=online and uncomment these values.
# OPENROUTER_API_KEY=replace-me
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=openai/gpt-4o-mini

